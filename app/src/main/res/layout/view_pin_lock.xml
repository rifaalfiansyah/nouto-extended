<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp">

    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="28dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/pin_lock_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/lock_24px"
            app:tint="?attr/colorOnPrimaryContainer" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textFontWeight="600"
        tools:text="App locked" />

    <TextView
        android:id="@+id/pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Enter your 4-digit PIN" />

    <LinearLayout
        android:id="@+id/pin_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/pin_dot_1"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pin_dot" />

        <View
            android:id="@+id/pin_dot_2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pin_dot" />

        <View
            android:id="@+id/pin_dot_3"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pin_dot" />

        <View
            android:id="@+id/pin_dot_4"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pin_dot" />
    </LinearLayout>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_1"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="1"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_2"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="2"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_3"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="3"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_4"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="4"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_5"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="5"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_6"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="6"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_7"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="7"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_8"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="8"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_9"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="9"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_biometric"
            style="@style/Widget.Nouto.PinActionButton"
            android:contentDescription="@string/app_lock_biometric_description"
            android:visibility="invisible"
            app:icon="@drawable/fingerprint_24px" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_0"
            style="@style/Widget.Nouto.PinKeyButton"
            android:text="0"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pin_key_backspace"
            style="@style/Widget.Nouto.PinActionButton"
            android:contentDescription="@string/app_lock_backspace_description"
            app:icon="@drawable/backspace_24px" />
    </GridLayout>
</LinearLayout>
