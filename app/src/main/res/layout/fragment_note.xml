<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceContainer"
    tools:context=".ui.fragments.NoteFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_collapseMode="pin">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/top_app_bar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minHeight="?attr/actionBarSize"
                android:paddingStart="16dp"
                android:theme="@style/ThemeOverlay.CircleNavigationButton"
                app:navigationIcon="@drawable/arrow_back_24px"
                tools:ignore="RtlSymmetry">
            </com.google.android.material.appbar.MaterialToolbar>

            <com.google.android.material.button.MaterialButtonGroup
                android:id="@+id/button_group_menu"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center_vertical|end"
                android:spacing="8dp">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
                    android:id="@+id/button_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/open_menu"
                    app:icon="@drawable/more_vert_24px"
                    app:backgroundTint="?colorSurfaceContainerHighest"
                    app:iconTint="?colorOnSurfaceVariant"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small.Narrow" />
            </com.google.android.material.button.MaterialButtonGroup>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.onegravity.rteditor.RTEditText
                android:id="@+id/note_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:maxWidth="840dp"
                android:backgroundTint="@android:color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/title"
                android:imeOptions="flagNoFullscreen"
                android:inputType="textCapSentences|textMultiLine"
                android:textAppearance="?textAppearanceDisplaySmallEmphasized"
                android:textFontWeight="500"
                app:layout_constraintWidth_max="840dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

            <Space
                android:id="@+id/note_content_spacing"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/note_metadata_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:orientation="horizontal"
                app:layout_goneMarginTop="16dp"
                app:layout_constraintWidth_max="840dp"
                app:layout_constraintTop_toBottomOf="@id/note_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:id="@+id/note_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="?colorOnSurfaceVariant"
                    app:backgroundTint="?colorSurfaceBright"
                    tools:text="Today, 4:10 PM" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:id="@+id/note_words"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/recycler_view_segmented_list_margin"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="?colorOnSurfaceVariant"
                    app:backgroundTint="?colorSurfaceBright"
                    tools:text="2 Words" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:id="@+id/note_characters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/recycler_view_segmented_list_margin"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:singleLine="true"
                    android:textAlignment="center"
                    android:textColor="?colorOnSurfaceVariant"
                    app:backgroundTint="?colorSurfaceBright"
                    tools:text="10 Characters" />
            </LinearLayout>

            <com.onegravity.rteditor.RTEditText
                android:id="@+id/note_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:accessibilityTraversalAfter="@id/floating_toolbar"
                android:backgroundTint="@android:color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/notes_hint"
                android:imeOptions="flagNoFullscreen"
                android:inputType="textCapSentences|textMultiLine"
                android:textAppearance="?textAppearanceTitleLarge"
                app:layout_constraintWidth_max="840dp"
                app:layout_constraintTop_toBottomOf="@id/note_metadata_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0"
                tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButtonGroup
        android:id="@+id/button_group_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:background="?colorSurfaceContainer"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            style="@style/OutlinedButton"
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3Expressive.Button"
            android:id="@+id/button_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_button"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
    </com.google.android.material.button.MaterialButtonGroup>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        style="@style/Widget.Nouto.FloatingToolbar"
        android:id="@+id/floating_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_margin="12dp"
        android:accessibilityTraversalBefore="@id/note_content"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.behavior.HideViewOnScrollBehavior"
        tools:visibility="visible">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/action_undo"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="false"
                    android:contentDescription="@string/undo"
                    app:icon="@drawable/undo_24px" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/action_redo"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="false"
                    android:contentDescription="@string/redo"
                    app:icon="@drawable/redo_24px" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:alpha="0.22"
                    android:background="@drawable/bg_toolbar_divider" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_bold"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/bold_style_description"
                    app:icon="@drawable/format_bold_24px" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_italic"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/italic_style_description"
                    app:icon="@drawable/format_italic_24px" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_underline"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/underline_style_description"
                    app:icon="@drawable/format_underlined_24px" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_strikethrough"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/strikethrough_style_description"
                    app:icon="@drawable/format_strikethrough_24px" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="3dp"
                    android:alpha="0.22"
                    android:background="@drawable/bg_toolbar_divider" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_bullet_list"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/bullet_list_style_description"
                    app:icon="@drawable/format_list_bulleted_24px" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Nouto.FloatingToolbar.IconButton"
                    android:id="@+id/style_numbered_list"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="1dp"
                    android:checkable="true"
                    android:contentDescription="@string/numbered_list_style_description"
                    app:icon="@drawable/format_list_numbered_24px" />
            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    <com.google.android.material.button.MaterialButtonGroup
        android:id="@+id/button_group_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:padding="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="?colorSurfaceContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_permanently"
            style="@style/OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_permanently"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium"/>

    </com.google.android.material.button.MaterialButtonGroup>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        style="?extendedFloatingActionButtonMediumStyle"
        android:id="@+id/button_edit_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/edit_note"
        android:text="@string/edit_note"
        android:visibility="gone"
        app:icon="@drawable/edit_24px"
        tools:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>